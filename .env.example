# ==============================================================================
# NEXUS ENTERPRISE ERP — MASTER ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & PERSISTENCE (PostgreSQL 16 Multi-Tenant RLS + Redis 7)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://nexus_admin:your_db_password_here@localhost:5432/nexus_erp_master?schema=public&sslmode=prefer"
DATABASE_DIRECT_URL="postgresql://nexus_admin:your_db_password_here@localhost:5432/nexus_erp_master"
REDIS_URL="redis://:your_redis_secret_here@localhost:6379/0"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SINGLE SIGN-ON (iam-service)
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY="YOUR_RSA_PRIVATE_KEY_PEM_HERE"
JWT_PUBLIC_KEY="YOUR_RSA_PUBLIC_KEY_PEM_HERE"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
ARGON2_SECRET_SALT="YOUR_ARGON2_SECRET_SALT_HERE"

# Okta SSO OAuth2 / OIDC API Keys
OKTA_DOMAIN="https://your-org.okta.com"
OKTA_CLIENT_ID="your_okta_client_id_here"
OKTA_CLIENT_SECRET="your_okta_client_secret_here"
OKTA_REDIRECT_URI="http://localhost:3001/api/v1/auth/sso/okta/callback"

# Microsoft Entra ID / Azure AD SSO
AZURE_AD_TENANT_ID="your_azure_tenant_id_here"
AZURE_AD_CLIENT_ID="your_azure_client_id_here"
AZURE_AD_CLIENT_SECRET="your_azure_client_secret_here"
AZURE_AD_REDIRECT_URI="http://localhost:3001/api/v1/auth/sso/azure/callback"

# ------------------------------------------------------------------------------
# 3. AI TIER & OCR VISION (ai-service: LangGraph Python 3.12 / ADR-014)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Anthropic Claude (Alternative)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# OCR Invoice Extraction (AWS Textract / Azure Form Recognizer)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key_here"
AWS_S3_INVOICE_BUCKET="nexus-erp-ocr-invoices-ap-south-1"

# ------------------------------------------------------------------------------
# 4. EVENT BACKBONE & SAGAS (Kafka MSK & Temporal.io)
# ------------------------------------------------------------------------------
KAFKA_BROKERS="localhost:9094"
KAFKA_CLIENT_ID="nexus-erp-service-layer"
KAFKA_GROUP_ID="nexus-erp-consumer-group"
KAFKA_SCHEMA_REGISTRY_URL="http://localhost:8081"

TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL NOTIFICATIONS & 2FA (notification-service)
# ------------------------------------------------------------------------------
RESEND_API_KEY="your_resend_api_key_here"
SYSTEM_FROM_EMAIL="noreply@nexus-erp.com"
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+15551234567"

# ------------------------------------------------------------------------------
# 6. BANKING FEEDS & STRIPE BILLING (banking-service & billing-service)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"
PLAID_CLIENT_ID="your_plaid_client_id_here"
PLAID_SECRET="your_plaid_secret_here"
PLAID_ENV="sandbox"
